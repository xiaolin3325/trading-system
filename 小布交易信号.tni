小布交易信号
---

BBI:(MA(CLOSE,3)+MA(CLOSE,6)+MA(CLOSE,12)+MA(CLOSE,24))/4;

{用量}
VOL5:=MA(VOL,5);

{条件组}
BBIDOWN:=CLOSE<BBI;
SUOLIANG:=VOL<VOL5*0.7;
ZHENFU5:=(HHV(HIGH,5)-LLV(LOW,5))/LLV(LOW,5)*100>5;
QIQIZT:=EXIST(C/REF(C,1)>=1.095,7);

{综合分数}
SCORE:=IF(BBIDOWN,3,0)+IF(SUOLIANG,3,0)+IF(ZHENFU5,2,0)+IF(QIQIZT,2,0);

{信号绘制}
DRAWTEXT(BBIDOWN,BBI*0.98,'↓'),COLORWHITE;
DRAWTEXT(SUOLIANG AND BBIDOWN,BBI,'缩'),COLORYELLOW;
DRAWTEXT(SCORE>=7,BBI*1.02,'买'),COLORRED;

{输出}
BBIDOWN,COLORFFFFFF,NODRAW;
SUOLIANG,COLORFFFFFF,NODRAW;
ZHENFU5,COLORFFFFFF,NODRAW;
QIQIZT,COLORFFFFFF,NODRAW;
SCORE,COLORFFAA00,NODRAW;